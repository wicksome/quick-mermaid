#!/usr/bin/env bash
# qmmd — renders mermaid text in a QuickMermaid panel.
#   pbpaste | qmmd        # render from pipe (stdin)
#   qmmd flow.mmd a.mmd   # render files
#   qmmd                  # run with no input → settings window
#   pbpaste | qmmd --link # print a clickable quickmermaid:// link instead of rendering
set -euo pipefail

BIN="/Applications/QuickMermaid.app/Contents/MacOS/QuickMermaid"
if [ ! -x "$BIN" ]; then
  echo "qmmd: QuickMermaid.app not found in /Applications." >&2
  exit 1
fi

if [ "${1:-}" = "--link" ] || [ "${1:-}" = "--encode" ]; then
  # print a quickmermaid:// link for the given files (or stdin) instead of rendering
  shift
  if [ "$#" -gt 0 ]; then cat "$@" | "$BIN" --encode; else "$BIN" --encode; fi
elif [ "$#" -gt 0 ]; then
  # if file arguments are given, concatenate and render them
  cat "$@" | "$BIN" --stdin
elif [ -t 0 ]; then
  # run interactively without a pipe → settings window
  "$BIN" --settings
else
  # render from pipe (stdin)
  "$BIN" --stdin
fi
