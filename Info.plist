<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>QuickMermaid</string>
    <key>CFBundleDisplayName</key>
    <string>QuickMermaid</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleIdentifier</key>
    <string>me.wickso.quickmermaid</string>
    <key>CFBundleVersion</key>
    <string>0.0.0</string>
    <key>CFBundleShortVersionString</key>
    <string>0.0.0</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleExecutable</key>
    <string>QuickMermaid</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Render Mermaid</string>
            </dict>
            <key>NSMessage</key>
            <string>renderMermaid</string>
            <key>NSPortName</key>
            <string>QuickMermaid</string>
            <key>NSSendTypes</key>
            <array>
                <string>public.utf8-plain-text</string>
                <string>public.plain-text</string>
                <string>NSStringPboardType</string>
            </array>
            <!-- Empty context = no contextual restriction; required for the
                 service to surface in the right-click Services menu of some
                 apps (e.g. Slack/Electron). Mirrors Hammerspoon's declaration. -->
            <key>NSRequiredContext</key>
            <dict/>
        </dict>
    </array>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>me.wickso.quickmermaid.render</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>quickmermaid</string>
            </array>
        </dict>
    </array>
    <!-- Mermaid source files (.mmd / .mermaid). There is no system UTI for them,
         so declare one as *imported* (we don't own the format): if another app
         declares the same extensions, LaunchServices merges rather than fights. -->
    <key>UTImportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>me.wickso.quickmermaid.mermaid-source</string>
            <key>UTTypeDescription</key>
            <string>Mermaid Diagram</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.plain-text</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict>
                <key>public.filename-extension</key>
                <array>
                    <string>mmd</string>
                    <string>mermaid</string>
                </array>
            </dict>
        </dict>
    </array>
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Mermaid Diagram</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Default</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>me.wickso.quickmermaid.mermaid-source</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
